#!/bin/sh
#
# PX4 FMUv6X specific board MAVLink startup script.
#------------------------------------------------------------------------------

# Wildfire BTB adapter: dedicate UART12 on J5 to telemetry.
mavlink start -d /dev/ttyS12 -b 57600 -r 4000 -m onboard_low_bandwidth -x

# Ensure nothing else starts on TEL1 (ttyS12)
set PRT_TEL1_ 1
