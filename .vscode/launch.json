        {
            "name": "PX4 v6XHPM Bootloader (FT2232/OpenOCD)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/px4_fmu-v6xhpm_bootloader/px4_fmu-v6xhpm_bootloader.elf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "riscv32-unknown-elf-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "preLaunchTask": "OpenOCD FT2232 PX4 v6XHPM",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing"
                },
                {
                    "text": "set pagination off"
                }
            ],
            "customLaunchSetupCommands": [
                {
                    "text": "target extended-remote localhost:3333"
                },
                {
                    "text": "file ${workspaceFolder}/build/px4_fmu-v6xhpm_bootloader/px4_fmu-v6xhpm_bootloader.elf"
                },
                {
                    "text": "load"
                },
                {
                    "text": "tbreak bootloader_main"
                },
                {
                    "text": "monitor reset run"
                }
            ],
            "launchCompleteCommand": "exec-continue"
        },
